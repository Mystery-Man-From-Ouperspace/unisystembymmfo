<section 
    {{log 'character-tab-core' this}} 
    class='tab main {{tab.cssClass}}'
    data-group='primary'
    data-tab='character-tab-core'
>

    {{!-- Core Tab --}}
    <div class="bio-container">
        <div id="logo"></div>
        <h2>{{ localize "UNISYSTEM.Description" }} ({{ localize (concat "UNISYSTEM." gamesystem) }})</h2>
        {{editor enrichedDescription target="system.biography" button=true editable=editable engine="prosemirror"}}

    </div>
    <div class="professsion-container">
        <h2>Profession</h2>
        <input type="text" name="system.profession" value="{{actor.system.profession}}">
    </div>
    <div class="skill-item-container">
        <div class="qualities-container">
            <h2 id="quality-header" class="header-with-button">
                <button type="button" class="create-item" data-create="quality">+</button> 
                <span>{{ localize "UNISYSTEM.Qualities & Pulling Strings" }}</span>
            </h2>
            <table class="item-table">
                <thead>
                    <tr>
                        <th class="table-left-align">{{ localize "UNISYSTEM.Qualities" }}</th>
                        <th>{{ localize "UNISYSTEM.Points" }}</th>
                        <th class="trash"><span title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each actor.quality as |item id|}}
                        <tr class="item" data-item-id="{{item._id}}">
                            <td class="item-name" data-action="edit" data-item-id="{{item._id}}">{{item.name}}</td>
                            <td class="table-center-align">{{item.system.cost}}</td>
                            <td class="trash table-center-align"><a class="item-control item-delete" data-action="delete" data-item-id="{{item._id}}" title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></a></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>

            <table class="item-table">
                <thead>
                    <tr>
                        <th class="table-left-align">{{ localize "UNISYSTEM.Pulling Strings" }}</th>
                        <th>{{ localize "UNISYSTEM.Points" }}</th>
                        <th class="trash"><span title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each actor.pullingStrings as |item id|}}
                        <tr class="item" data-item-id="{{item._id}}">
                            <td class="item-name" data-action="edit" data-item-id="{{item._id}}">{{item.name}}</td>
                            <td class="table-center-align">{{item.system.cost}}</td>
                            <td class="trash table-center-align"><a class="item-control item-delete" data-action="delete" data-item-id="{{item._id}}" title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></a></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>

        </div>
        <div class="drawbacks-container">
            <h2 id="drawback-header" class="header-with-button">
                <button type="button" class="create-item" data-create="drawback">+</button> 
                <span>{{ localize "UNISYSTEM.Drawbacks" }}</span>
            </h2>
            <table class="item-table">
                <thead>
                    <tr>
                        <th class="table-left-align">{{ localize "UNISYSTEM.Name" }}</th>
                        <th>{{ localize "UNISYSTEM.Points" }}</th>
                        <th class="trash"><span title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each actor.drawback as |item id|}}
                        <tr class="item" data-item-id="{{item._id}}">
                            <td class="item-name" data-action="edit" data-item-id="{{item._id}}">{{item.name}}</td>
                            <td class="table-center-align">{{item.system.cost}}</td>
                            <td class="trash table-center-align"><a class="item-control item-delete" data-action="delete" data-item-id="{{item._id}}" title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></a></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <div class="skill-item-container">
        <div class="skills-container">
            <h2 id="skill-header" class="header-with-button">
                <button type="button" class="create-item" data-create="skill">+</button> 
                <span>{{ localize "UNISYSTEM.Skills" }}</span>
            </h2>
            <table class="item-table">
                <thead>
                    <tr>
                        <th class="table-left-align">{{ localize "UNISYSTEM.Name" }}</th>
                        <th>{{ localize "UNISYSTEM.Level" }}</th>
                        <th class="trash"><span title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each actor.skill as |item id|}}
                        <tr class="item" data-item-id="{{item._id}}">
                            <td class="item-name" data-action="edit" data-item-id="{{item._id}}">{{item.name}}</td>
                            <td class="table-center-align">{{item.system.level}}</td>
                            <td class="trash table-center-align"><a class="item-control item-delete" data-action="delete" data-item-id="{{item._id}}" title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></a></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="powers-container">
            <h2 id="power-header" class="header-with-button">
                <button type="button" class="create-item" data-create="power">+</button> 
                <span>{{ localize "UNISYSTEM.Powers" }}</span>
            </h2>
            <table class="item-table">
                <thead>
                    <tr>
                        <th class="table-left-align">{{ localize "UNISYSTEM.Name" }}</th>
                        <th>{{ localize "UNISYSTEM.Level" }}</th>
                        <th class="trash"><span title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each actor.power as |item id|}}
                        <tr class="item" data-item-id="{{item._id}}">
                            <td class="item-name" data-action="edit" data-item-id="{{item._id}}">{{item.name}}</td>
                            <td class="table-center-align">{{item.system.level}}</td>
                            <td class="trash table-center-align"><a class="item-control item-delete" data-action="delete" data-item-id="{{item._id}}" title="{{ localize 'UNISYSTEM.Delete Item' }}"><i class="fas fa-trash"></i></a></td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>