    <div class="vehicles-table">
        <h2 class="header-with-button">
            <button type="button" class="create-item" data-create="vehicles">+</button> 
            <span>{{ localize "UNISYSTEM.Vehicles & Accessories" }}</span>
        </h2>
        <table>
